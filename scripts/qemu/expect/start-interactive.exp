set timeout 30
spawn /agentbox start interactive interactive
expect {
	"DUMMY_AGENT_READY" {}
	timeout { puts stderr "agent did not ask its test question"; exit 1 }
	eof { puts stderr "agent exited before asking its test question"; exit 1 }
}
send -- "approve staging\r"
expect {
	"DUMMY_AGENT_ANSWER=approve staging" {}
	timeout { puts stderr "agent did not receive the answer"; exit 1 }
	eof { puts stderr "agent exited before recording the answer"; exit 1 }
}
send -- "\020\021"
expect {
	eof {}
	timeout { puts stderr "could not detach from agent"; exit 1 }
}
