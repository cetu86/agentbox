set timeout 30
set name [lindex $argv 0]
spawn /agentbox attach $name
send -- "finish\r"
expect {
	"DUMMY_AGENT_CONTINUING" {}
	timeout { puts stderr "reattached agent did not receive input"; exit 1 }
	eof { puts stderr "agent exited before receiving input"; exit 1 }
}
expect {
	eof {}
	timeout { puts stderr "agent did not finish after reattaching"; exit 1 }
}
