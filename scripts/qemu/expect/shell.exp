set timeout 30
set name [lindex $argv 0]
spawn /agentbox shell $name
expect {
	-re {[^#\r\n]*# ?$} {}
	timeout { puts stderr "interactive shell did not present a prompt"; exit 1 }
}
send -- "stty -echo\r"
expect {
	-re {[^#\r\n]*# ?$} {}
	timeout { puts stderr "could not disable shell input echo"; exit 1 }
}
send -- "printf 'DUMMY_SHELL_OK\\n'\r"
expect {
	"DUMMY_SHELL_OK" {}
	timeout { puts stderr "shell could not execute a command in the agent container"; exit 1 }
}
send -- "exit\r"
expect {
	eof {}
	timeout { puts stderr "shell did not exit"; exit 1 }
}
